{
  // Dev / editor / `tsc --noEmit`: every source, with Node types available
  // because src/cli/** reads files and writes stdout. It emits nothing —
  // tsconfig.build.json owns dist/, and tsconfig.engine.json is the narrower
  // environment-free compile the library boundary rests on.
  //
  // The suites in test/ are plain JS and are not type-checked, here or in
  // MapyClimbs; vitest is what runs them.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["node"]
  },
  "include": ["src"]
}
