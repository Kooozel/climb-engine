{
  // The emitting config. Output is unbundled — one .js plus .d.ts per module —
  // so a consumer's bundler can tree-shake it ("sideEffects": false) and stack
  // traces in the extension name a real file. `types: ["node"]` is here for
  // src/cli/index.ts alone; nothing under the root entry point may use it, and
  // scripts/check-no-node-imports.mjs fails the build if any emitted file other
  // than the bin ends up with a `node:` specifier.
  //
  // src/cli/index.ts is excluded: it is arg parsing, file reads and printing —
  // the CLI's one impure file — and it ships only as the esbuild bundle that
  // `bin` points at. Emitting it unbundled would put a second, unreachable copy
  // in dist/ and a `node:fs` import in the library tree. `tsc --noEmit` over
  // tsconfig.json still type-checks it.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/cli/index.ts"]
}
