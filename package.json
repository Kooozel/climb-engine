{
  "name": "climb-engine",
  "version": "0.1.0",
  "description": "Cycling and hiking climb detection from GPX — a pure, deterministic engine",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20.17"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "climb-cli": "./dist/climb-cli.mjs"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./gpx": { "types": "./dist/gpx.d.ts", "default": "./dist/gpx.js" },
    "./ride": { "types": "./dist/cli/analyze-ride.d.ts", "default": "./dist/cli/analyze-ride.js" },
    "./geo": { "types": "./dist/geo.d.ts", "default": "./dist/geo.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-cli.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ scripts/ eslint.config.js",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
